import unittest
from main import MailClassifier

class TestMailClassifier(unittest.TestCase):
    def setUp(self):
        self.classifier = MailClassifier()

    def test_classifies_known_categories(self):
        test_cases = [
            ("Срочно: сервер не работает", "admin@company.com", "Произошел критический инцидент, нужна срочная помощь", "important"),
            ("Проблема с ноутбуком", "user@company.com", "Мне сломали экран ноутбука", "hardware"),
            ("Ошибка в приложении", "user@company.com", "Программа не запускается, появляется код ошибки", "software"),
            ("Запрос доступа", "employee@company.com", "Нужно выдать права в GitLab и VPN", "access"),
            ("Плановые технические работы", "it@company.com", "Уведомляю о плановых работах", "info"),
            ("Вы выиграли приз!", "promo@example.com", "!!!Перейдите по ссылке и получите айфон!!!", "spam"),
            ("Взлом учетной записи", "security@company.com", "Необходимо немедленно сменить пароль", "important"),
            ("Сломался принтер", "office@company.com", "Застревает бумага, вызывайте мастера", "hardware"),
            ("Вылетает браузер", "user@company.com", "Chrome закрывается при открытии других приложений", "software"),
            ("VPN доступ для удаленки", "remote@company.com", "Не могу подключиться, откройте доступ", "access"),
            ("Демо новой версии", "product@company.com", "Приглашаем на вебинар во вторник", "info"),
            ("Предложение встретиться в столовой", "colleague@company.com", "Обсудим контракт за комплексом", "meetings"),
            ("Перенос ежеквартального отчёта", "finance@company.com", "Созвон переносится на среду", "meetings"),
            ("Внёс правки в инструкцию", "techwriter@company.com", "Обновил техническое задание", "docs"),
            ("Замечания к техническому заданию", "client@company.com", "Пункт 6.7 требует уточнения", "docs"),
            ("Банковский перевод", "finance@company.com", "Прилагаю чек за выполненную работу", "finance"),
            ("Контракт и счета", "sales@company.com", "Выставьте счёт на оплату", "finance"),
        ]
        for subject, sender, body, expected in test_cases:
            with self.subTest(subject=subject, sender=sender, body=body):
                result = self.classifier.classify(subject, sender, body)
                self.assertEqual(result, expected)

    def test_unknown_email_without_keywords(self):
        result = self.classifier.classify(
            subject="Анекдот от Карахана",
            sender="karahan@edu.hse.ru",
            body="Было у меня три студента:...",
        )
        self.assertEqual(result, "inbox")

    def test_empty_email(self):
        result = self.classifier.classify(subject="", sender="", body="")
        self.assertEqual(result, "inbox")
